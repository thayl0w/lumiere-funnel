{"target":"production","name":"lumiere-funnel","teamId":"team_baJLuuc8uh4YDSmTlgowL3rx","projectSettings":{"framework":"nextjs","buildCommand":"npm run build","installCommand":"npm install"},"files":[{"file":".gitignore","data":"# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.\n\n# dependencies\n/node_modules\n/.pnp\n.pnp.*\n.yarn/*\n!.yarn/patches\n!.yarn/plugins\n!.yarn/releases\n!.yarn/versions\n\n# testing\n/coverage\n\n# next.js\n/.next/\n/out/\n\n# misc\n.DS_Store\n*.pem\n\n# debug\nnpm-debug.log*\nyarn-debug.log*\nyarn-error.log*\n.pnpm-debug.log*\n\n# env files (can opt-in for committing if needed)\n.env*\n\n# vercel\n.vercel\n\n# typescript\nnext-env.d.ts\n/dist/\n/.wrangler/\n/.sites-runtime/\n/outputs/\n/work/\n"},{"file":".npmrc","data":"audit=false\nfund=false\nupdate-notifier=false\ncache=.sites-runtime/npm-cache\n"},{"file":"app/booking/page.tsx","data":"\"use client\";\n\nimport { useMemo, useState } from \"react\";\nimport {\n  ArrowLeft,\n  ArrowRight,\n  CalendarDays,\n  Check,\n  ChevronDown,\n  ChevronLeft,\n  ChevronRight,\n  Clock3,\n  Heart,\n  LockKeyhole,\n  Mail,\n  MessagesSquare,\n  ShieldCheck,\n  Sparkles,\n} from \"lucide-react\";\nimport Link from \"next/link\";\nimport { Footer, Header, TrustBar } from \"../components\";\n\nconst times = [\"9:00 AM\", \"11:00 AM\", \"1:00 PM\", \"3:00 PM\", \"5:00 PM\", \"7:00 PM\"];\nconst monthNames = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\nconst dayNames = [\"SUN\", \"MON\", \"TUE\", \"WED\", \"THU\", \"FRI\", \"SAT\"];\n\nconst bookingFaqs = [\n  [\"Is the discovery call really free?\", \"Yes. The 30-minute discovery call is complimentary and comes with no obligation.\"],\n  [\"What if I need to reschedule?\", \"You can select a new date and time here before confirming. For a booked call, reply to your confirmation email.\"],\n  [\"What can I expect on the call?\", \"We’ll talk through your goals, current routine, and the simplest next steps for your personalized glow plan.\"],\n];\n\nconst bookingTestimonials = [\n  [\"This guide was the perfect first step. I’ve never felt more inspired to take care of me.\", \"Sarah J.\", \"New York, NY\", \"/assets/results-skin.webp\"],\n  [\"Booking my discovery call was so easy. I felt supported from the very first click.\", \"Emily R.\", \"Austin, TX\", \"/assets/call-woman.webp\"],\n  [\"I love how personalized everything is. This isn’t just another program—it’s real.\", \"Megan L.\", \"Los Angeles, CA\", \"/assets/quiz-woman.webp\"],\n];\n\nexport default function Booking() {\n  const [monthOffset, setMonthOffset] = useState(0);\n  const [day, setDay] = useState(13);\n  const [time, setTime] = useState(\"11:00 AM\");\n  const [booked, setBooked] = useState(false);\n  const [openFaq, setOpenFaq] = useState<number | null>(null);\n\n  const calendar = useMemo(() => {\n    const date = new Date(2026, 7 + monthOffset, 1);\n    const year = date.getFullYear();\n    const month = date.getMonth();\n    return {\n      year,\n      month,\n      firstDay: new Date(year, month, 1).getDay(),\n      totalDays: new Date(year, month + 1, 0).getDate(),\n    };\n  }, [monthOffset]);\n\n  const changeMonth = (amount: number) => {\n    setMonthOffset((value) => value + amount);\n    setDay(1);\n    setBooked(false);\n  };\n\n  return (\n    <main className=\"bookingPage\">\n      <Header active=\"Book a Call\" />\n\n      <section className=\"bookingHero\">\n        <div className=\"callPortrait\" role=\"img\" aria-label=\"Woman welcoming you to your Lumière glow journey\" />\n        <div className=\"callWelcome\">\n          <p>WELCOME TO YOUR GLOW JOURNEY <Sparkles /></p>\n          <h1>You’re In!</h1>\n          <h2>Your Glow Guide<br />Is On The Way</h2>\n          <span>Thank you for saying YES to you.<br />I’m so excited to support you on your journey<br />to radiant skin, more energy, and total confidence.</span>\n          <Heart />\n        </div>\n\n        <div className=\"calendarCard\">\n          {booked ? (\n            <div className=\"bookedState\">\n              <span><Check /></span>\n              <b>You’re booked!</b>\n              <p>Your discovery call is set for<br /><strong>{monthNames[calendar.month]} {day}, {calendar.year} at {time}</strong>.</p>\n              <small>Look for your confirmation details in your inbox.</small>\n              <button onClick={() => setBooked(false)}><ArrowLeft /> Change date or time</button>\n              <Link className=\"button\" href=\"/\">RETURN HOME <ArrowRight /></Link>\n            </div>\n          ) : (\n            <>\n              <h2>Book Your<br />Discovery Call <Sparkles /></h2>\n              <p>Let’s create your personalized plan<br />and get real results—together.</p>\n              <div className=\"calendarFacts\">\n                <span><Clock3 /><b>30 Min</b><small>Session</small></span>\n                <span><MessagesSquare /><b>One-on-One</b><small>Expert Guidance</small></span>\n                <span><ShieldCheck /><b>100% Free</b><small>No Obligation</small></span>\n              </div>\n\n              <small className=\"calendarLabel\">1. SELECT A DATE</small>\n              <div className=\"calendar\">\n                <div className=\"calendarHead\">\n                  <button onClick={() => changeMonth(-1)} aria-label=\"Previous month\"><ChevronLeft /></button>\n                  <strong>{monthNames[calendar.month]} {calendar.year}</strong>\n                  <button onClick={() => changeMonth(1)} aria-label=\"Next month\"><ChevronRight /></button>\n                </div>\n                <div className=\"calendarGrid\">\n                  {dayNames.map((name) => <em key={name}>{name}</em>)}\n                  {Array.from({ length: calendar.firstDay }, (_, index) => <i key={`blank-${index}`} />)}\n                  {Array.from({ length: calendar.totalDays }, (_, index) => index + 1).map((number) => (\n                    <button key={number} className={day === number ? \"active\" : \"\"} onClick={() => setDay(number)} aria-pressed={day === number}>{number}</button>\n                  ))}\n                </div>\n              </div>\n\n              <small className=\"calendarLabel\">2. SELECT A TIME</small>\n              <div className=\"timeGrid\">\n                {times.map((slot) => <button key={slot} className={time === slot ? \"active\" : \"\"} onClick={() => setTime(slot)} aria-pressed={time === slot}>{slot}</button>)}\n              </div>\n              <button className=\"button bookButton\" onClick={() => setBooked(true)}>BOOK MY SESSION <ArrowRight /></button>\n              <div className=\"secure\"><LockKeyhole /> Your information is secure &amp; never shared.</div>\n            </>\n          )}\n        </div>\n      </section>\n\n      <TrustBar />\n\n      <section className=\"nextSteps shell\">\n        <h2>What Happens Next <Sparkles /></h2>\n        <div>\n          <article><i><Mail /></i><b>01</b><h3>Check Your Email</h3><p>Your Glow Guide is on its way!<br />It should arrive in the next few minutes.</p></article>\n          <article><i><CalendarDays /></i><b>02</b><h3>Book Your Call</h3><p>Schedule your free discovery call using<br />the calendar above at a time that works for you.</p></article>\n          <article><i><MessagesSquare /></i><b>03</b><h3>We Connect</h3><p>We’ll chat about your goals, challenges,<br />and create a custom plan for your glow.</p></article>\n          <article><i><Sparkles /></i><b>04</b><h3>Start Your Glow Journey</h3><p>Get expert guidance, personalized support,<br />and real results that last.</p></article>\n        </div>\n      </section>\n\n      <section className=\"bookingGuide\">\n        <div className=\"bookingGuideInner shell\">\n          <img src=\"/assets/guide.webp\" alt=\"Your free Glow From Within beauty and wellness guide\" />\n          <div>\n            <small>YOUR GUIDE IS ON ITS WAY <Sparkles /></small>\n            <h2>Your Free Beauty &amp;<br />Wellness Guide</h2>\n            <p>Packed with expert tips, daily rituals, and<br />empowering practices to help you glow<br />from the inside out.</p>\n            <ul><li><Check /> Nourish your skin &amp; body</li><li><Check /> Boost energy &amp; confidence</li><li><Check /> Simple rituals for real results</li></ul>\n          </div>\n        </div>\n      </section>\n\n      <section className=\"bookingReviews shell\">\n        <h2>Real Women. Real Results. <Sparkles /></h2>\n        <div className=\"bookingReviewGrid\">\n          {bookingTestimonials.map(([quote, name, place, avatar]) => (\n            <article key={name}>\n              <div className=\"stars\">★★★★★</div>\n              <p>“{quote}”</p>\n              <div className=\"reviewer\"><img src={avatar} alt=\"\" /><span><strong>{name}</strong><small>{place}</small></span></div>\n            </article>\n          ))}\n        </div>\n      </section>\n\n      <section className=\"bookingCta shell\">\n        <div>\n          <h2>Let’s Make Your Glow Unstoppable <Sparkles /></h2>\n          <p>Your next chapter starts with a conversation.<br />I can’t wait to meet you!</p>\n          <a className=\"button\" href=\"#top\" onClick={(event) => { event.preventDefault(); document.querySelector(\".calendarCard\")?.scrollIntoView({ behavior: \"smooth\", block: \"center\" }); }}>BOOK MY FREE CALL <ArrowRight /></a>\n        </div>\n        <img src=\"/assets/booking-cta-decor.webp\" alt=\"Soft candlelight and pink flowers\" />\n      </section>\n\n      <section className=\"bookingFaq shell\" id=\"faq\">\n        <h2>Frequently Asked Questions</h2>\n        <div>\n          {bookingFaqs.map(([question, answer], index) => (\n            <article className={openFaq === index ? \"open\" : \"\"} key={question}>\n              <button onClick={() => setOpenFaq(openFaq === index ? null : index)} aria-expanded={openFaq === index}>{question}<ChevronDown /></button>\n              <p>{answer}</p>\n            </article>\n          ))}\n        </div>\n      </section>\n\n      <Footer />\n    </main>\n  );\n}\n"},{"file":"app/chatgpt-auth.ts","data":"import { headers } from \"next/headers\";\nimport { redirect } from \"next/navigation\";\n\nexport type ChatGPTUser = {\n  displayName: string;\n  email: string;\n  fullName: string | null;\n};\n\nconst USER_EMAIL_HEADER = \"oai-authenticated-user-email\";\nconst USER_FULL_NAME_HEADER = \"oai-authenticated-user-full-name\";\nconst USER_FULL_NAME_ENCODING_HEADER =\n  \"oai-authenticated-user-full-name-encoding\";\nconst PERCENT_ENCODED_UTF8 = \"percent-encoded-utf-8\";\nconst SIGN_IN_PATH = \"/signin-with-chatgpt\";\nconst SIGN_OUT_PATH = \"/signout-with-chatgpt\";\nconst CALLBACK_PATH = \"/callback\";\n\nexport async function getChatGPTUser(): Promise<ChatGPTUser | null> {\n  const requestHeaders = await headers();\n  const email = requestHeaders.get(USER_EMAIL_HEADER);\n  if (!email) return null;\n\n  const encodedFullName = requestHeaders.get(USER_FULL_NAME_HEADER);\n  const fullName =\n    encodedFullName &&\n    requestHeaders.get(USER_FULL_NAME_ENCODING_HEADER) === PERCENT_ENCODED_UTF8\n      ? safeDecodeURIComponent(encodedFullName)\n      : null;\n\n  return {\n    displayName: fullName ?? email,\n    email,\n    fullName,\n  };\n}\n\nexport async function requireChatGPTUser(\n  returnTo: string,\n): Promise<ChatGPTUser> {\n  const user = await getChatGPTUser();\n  if (user) return user;\n\n  redirect(chatGPTSignInPath(returnTo));\n}\n\nexport function chatGPTSignInPath(returnTo: string): string {\n  const safeReturnTo = safeRelativeReturnPath(returnTo);\n  return `${SIGN_IN_PATH}?return_to=${encodeURIComponent(safeReturnTo)}`;\n}\n\nexport function chatGPTSignOutPath(returnTo = \"/\"): string {\n  const safeReturnTo = safeRelativeReturnPath(returnTo);\n  return `${SIGN_OUT_PATH}?return_to=${encodeURIComponent(safeReturnTo)}`;\n}\n\nfunction safeRelativeReturnPath(value: string): string {\n  if (!value.startsWith(\"/\") || value.startsWith(\"//\")) return \"/\";\n\n  let url: URL;\n  try {\n    url = new URL(value, \"https://app.local\");\n  } catch {\n    return \"/\";\n  }\n  if (url.origin !== \"https://app.local\") return \"/\";\n  if (isReservedAuthPath(url.pathname)) return \"/\";\n\n  return `${url.pathname}${url.search}${url.hash}`;\n}\n\nfunction isReservedAuthPath(pathname: string): boolean {\n  return (\n    pathname === SIGN_IN_PATH ||\n    pathname === SIGN_OUT_PATH ||\n    pathname === CALLBACK_PATH\n  );\n}\n\nfunction safeDecodeURIComponent(value: string): string | null {\n  try {\n    return decodeURIComponent(value);\n  } catch {\n    return null;\n  }\n}\n"},{"file":"app/components.tsx","data":"\"use client\";\n\nimport { useState } from \"react\";\nimport Link from \"next/link\";\nimport {\n  ArrowRight,\n  Facebook,\n  Heart,\n  Instagram,\n  Leaf,\n  Menu,\n  ShieldCheck,\n  Sparkles,\n  Star,\n  Users,\n  X,\n  Youtube,\n} from \"lucide-react\";\n\nconst navItems = [\n  [\"Home\", \"/\"],\n  [\"About\", \"/#about\"],\n  [\"Programs\", \"/#programs\"],\n  [\"Results\", \"/#results\"],\n  [\"Blog\", \"/#guide\"],\n  [\"Book a Call\", \"/booking\"],\n  [\"Contact\", \"/#contact\"],\n];\n\nexport function Brand({ inverse = false }: { inverse?: boolean }) {\n  return (\n    <Link className={`brand${inverse ? \" inverse\" : \"\"}`} href=\"/\" aria-label=\"Lumière Beauty and Wellness home\">\n      LUMIÈRE\n      <span>BEAUTY &amp; WELLNESS</span>\n    </Link>\n  );\n}\n\nexport function Header({ active = \"Home\" }: { active?: string }) {\n  const [open, setOpen] = useState(false);\n  return (\n    <header className=\"siteHeader\">\n      <div className=\"headerInner shell\">\n        <Brand />\n        <button\n          className=\"menuButton\"\n          aria-label={open ? \"Close navigation\" : \"Open navigation\"}\n          aria-expanded={open}\n          onClick={() => setOpen((value) => !value)}\n        >\n          {open ? <X /> : <Menu />}\n        </button>\n        <nav className={open ? \"open\" : \"\"} aria-label=\"Primary navigation\">\n          {navItems.map(([label, href]) => (\n            <Link key={label} className={active === label ? \"active\" : \"\"} href={href} onClick={() => setOpen(false)}>\n              {label}\n            </Link>\n          ))}\n        </nav>\n        <Link className=\"button headerCta\" href=\"/quiz\">\n          JOIN NOW <ArrowRight size={17} aria-hidden=\"true\" />\n        </Link>\n      </div>\n    </header>\n  );\n}\n\nconst trustItems = [\n  [Users, \"Trusted by 10,000+\", \"women\"],\n  [Star, \"4.9/5 average\", \"rating\"],\n  [ShieldCheck, \"Expert-backed\", \"wellness\"],\n  [Leaf, \"Simple daily\", \"rituals\"],\n  [Heart, \"Personalized\", \"wellness\"],\n] as const;\n\nexport function TrustBar() {\n  return (\n    <section className=\"trustBar\" aria-label=\"Lumière customer trust highlights\">\n      <div className=\"shell trustInner\">\n        {trustItems.map(([Icon, lineOne, lineTwo]) => (\n          <div className=\"trustItem\" key={lineOne}>\n            <Icon aria-hidden=\"true\" />\n            <span>{lineOne}<br />{lineTwo}</span>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}\n\nexport function Footer() {\n  const [email, setEmail] = useState(\"\");\n  const [joined, setJoined] = useState(false);\n  const [legal, setLegal] = useState<\"privacy\" | \"terms\" | null>(null);\n\n  return (\n    <footer id=\"contact\" className=\"siteFooter\">\n      <div className=\"shell footerGrid\">\n        <div className=\"footerIntro\">\n          <Brand />\n          <p>Empowering women to look, feel,<br />and live beautifully every day.</p>\n          <div className=\"socialLinks\" aria-label=\"Social links\">\n            <a href=\"https://www.instagram.com/\" aria-label=\"Instagram\"><Instagram /></a>\n            <a href=\"https://www.facebook.com/\" aria-label=\"Facebook\"><Facebook /></a>\n            <a href=\"https://www.youtube.com/\" aria-label=\"YouTube\"><Youtube /></a>\n          </div>\n        </div>\n        <div className=\"footerLinks\">\n          <b>EXPLORE</b>\n          <Link href=\"/#about\">About Us</Link>\n          <Link href=\"/#programs\">Programs</Link>\n          <Link href=\"/#results\">Success Stories</Link>\n          <Link href=\"/#guide\">Blog</Link>\n          <Link href=\"/#contact\">Contact</Link>\n        </div>\n        <div className=\"footerLinks\">\n          <b>RESOURCES</b>\n          <Link href=\"/#guide\">Beauty Guide</Link>\n          <Link href=\"/#guide\">Wellness Tips</Link>\n          <Link href=\"/quiz\">Glow Quiz</Link>\n          <Link href=\"/#faq\">FAQs</Link>\n          <Link href=\"/#contact\">Privacy Policy</Link>\n        </div>\n        <div className=\"footerConnect\">\n          <b>STAY CONNECTED</b>\n          <p>Get weekly tips, exclusive content,<br />and special offers.</p>\n          {joined ? (\n            <div className=\"newsletterSuccess\"><Sparkles size={16} /> You’re on the list—welcome!</div>\n          ) : (\n            <form onSubmit={(event) => { event.preventDefault(); if (email) setJoined(true); }}>\n              <label className=\"srOnly\" htmlFor=\"footer-email\">Email address</label>\n              <input id=\"footer-email\" type=\"email\" required value={email} onChange={(event) => setEmail(event.target.value)} placeholder=\"Enter your email\" />\n              <button aria-label=\"Join the Lumière newsletter\"><ArrowRight /></button>\n            </form>\n          )}\n        </div>\n      </div>\n      <div className=\"shell footerBottom\">\n        <span>© 2026 Lumière Beauty &amp; Wellness. All Rights Reserved.</span>\n        <span><button onClick={() => setLegal(\"privacy\")}>Privacy Policy</button><button onClick={() => setLegal(\"terms\")}>Terms of Use</button></span>\n      </div>\n      {legal && (\n        <div className=\"legalOverlay\" role=\"presentation\" onMouseDown={() => setLegal(null)}>\n          <section className=\"legalDialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"legal-title\" onMouseDown={(event) => event.stopPropagation()}>\n            <button className=\"legalClose\" onClick={() => setLegal(null)} aria-label=\"Close legal information\"><X /></button>\n            <small>LUMIÈRE BEAUTY &amp; WELLNESS</small>\n            <h2 id=\"legal-title\">{legal === \"privacy\" ? \"Privacy Policy\" : \"Terms of Use\"}</h2>\n            {legal === \"privacy\" ? (\n              <p>This portfolio experience only uses information you enter to demonstrate the on-page quiz, guide, and booking interactions. It does not transmit or store your personal information. Connect your approved email, analytics, and scheduling services before using the site with real customers.</p>\n            ) : (\n              <p>This is a front-end demonstration of the Lumière customer journey. Guide delivery, consultation availability, customer accounts, payments, and professional advice require the appropriate live services and business policies before public use.</p>\n            )}\n            <button className=\"button\" onClick={() => setLegal(null)}>GOT IT</button>\n          </section>\n        </div>\n      )}\n    </footer>\n  );\n}\n"},{"file":"app/globals.css","data":"@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap');\n\n:root {\n  --ink: #17191a;\n  --muted: #5f5b5b;\n  --rose: #d94d68;\n  --rose-dark: #cc3f5d;\n  --coral: #ef7d80;\n  --peach: #f6b1a8;\n  --blush: #fff3f1;\n  --cream: #fffaf8;\n  --line: #efd8d5;\n  --shadow: 0 18px 46px rgba(108, 70, 59, .14);\n}\n\n* { box-sizing: border-box; }\nhtml { scroll-behavior: smooth; }\nbody { margin: 0; color: var(--ink); background: #fff; font-family: 'DM Sans', sans-serif; -webkit-font-smoothing: antialiased; }\nbutton, input { font: inherit; }\nbutton, a { -webkit-tap-highlight-color: transparent; }\nimg { display: block; max-width: 100%; image-rendering: auto; }\na { color: inherit; }\n.shell { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }\n.srOnly { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }\n\n:focus-visible { outline: 3px solid rgba(217, 77, 104, .3); outline-offset: 3px; }\n\n.button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  min-height: 48px;\n  border: 0;\n  border-radius: 7px;\n  padding: 13px 26px;\n  background: linear-gradient(110deg, #d33e5c, #df5771);\n  color: #fff;\n  box-shadow: 0 9px 22px rgba(208, 57, 88, .22);\n  text-decoration: none;\n  font-weight: 700;\n  letter-spacing: .02em;\n  cursor: pointer;\n  transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;\n}\n.button:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(208, 57, 88, .3); filter: saturate(1.08); }\n.button:active { transform: translateY(-1px); }\n.button:disabled { opacity: .45; cursor: not-allowed; transform: none; box-shadow: none; }\n.button svg { width: 18px; height: 18px; flex: 0 0 auto; transition: transform .25s ease; }\n.button:hover svg { transform: translateX(3px); }\n\n/* Shared header */\n.siteHeader { height: 86px; background: rgba(255,255,255,.96); position: relative; z-index: 50; border-bottom: 1px solid rgba(239, 216, 213, .38); }\n.headerInner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }\n.brand { display: inline-block; color: #eb7779; text-decoration: none; font-size: 25px; line-height: 1; letter-spacing: 7px; white-space: nowrap; }\n.brand span { display: block; color: #555; font-size: 8px; font-weight: 500; letter-spacing: 3px; text-align: center; margin-top: 8px; }\n.brand.inverse { color: #fff; }\n.brand.inverse span { color: rgba(255,255,255,.7); }\n.siteHeader nav { display: flex; align-items: center; gap: clamp(22px, 2.6vw, 40px); }\n.siteHeader nav a { position: relative; padding: 32px 0 27px; color: #232323; text-decoration: none; font-size: 14px; }\n.siteHeader nav a::after { content: ''; position: absolute; left: 50%; right: 50%; bottom: 21px; height: 2px; background: var(--coral); transition: left .25s ease, right .25s ease; }\n.siteHeader nav a:hover::after, .siteHeader nav a.active::after { left: 0; right: 0; }\n.headerCta { min-height: 46px; padding: 11px 23px; font-size: 13px; }\n.menuButton { display: none; border: 0; background: transparent; color: var(--ink); padding: 8px; cursor: pointer; }\n.menuButton svg { display: block; }\n\n/* Home hero */\n.homeHero { min-height: 590px; background-image: url('/assets/home-hero-left.webp'), url('/assets/home-hero-right.webp'), linear-gradient(100deg, #fff8f5 0%, #fff9f8 54%, #f7ded7 100%); background-position: left center, right center, center; background-size: auto 100%, auto 100%, cover; background-repeat: no-repeat; overflow: hidden; position: relative; }\n.homeHero::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 2% 44%, rgba(239, 164, 155, .28), transparent 17%), radial-gradient(circle at 95% 40%, rgba(225, 149, 137, .2), transparent 20%); }\n.homeHeroInner { min-height: 590px; display: grid; grid-template-columns: 36% 34% 30%; align-items: center; position: relative; }\n.heroCopy { position: relative; z-index: 2; padding: 25px 0 10px; }\n.eyebrow { display: flex; align-items: center; gap: 7px; margin: 0; font-size: 12px; font-weight: 700; letter-spacing: .2em; }\n.eyebrow svg { width: 15px; height: 15px; color: var(--coral); fill: rgba(239, 125, 128, .14); }\n.heroCopy h1 { margin: 20px 0 28px; font: 500 clamp(64px, 6.2vw, 90px)/.94 'Playfair Display', serif; letter-spacing: -.045em; }\n.heroCopy h1 em { display: block; color: var(--rose); 