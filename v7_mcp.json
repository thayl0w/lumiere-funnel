n  .shell { width: calc(100% - 28px); }\n  .headerCta svg { display: none; }\n  .homeHero { min-height: 930px; }\n  .homeHeroInner { min-height: 930px; display: block; padding-top: 38px; text-align: center; }\n  .heroCopy { padding: 0; }\n  .eyebrow { justify-content: center; font-size: 10px; letter-spacing: .13em; }\n  .heroCopy h1 { margin-block: 17px 20px; font-size: clamp(54px, 17vw, 68px); }\n  .heroLead { max-width: 345px; margin-inline: auto; font-size: 13px; }\n  .heroBenefits { justify-content: center; flex-wrap: wrap; gap: 11px 17px; margin-top: 22px; }\n  .heroWoman { left: -10px; right: -10px; top: 285px; height: 390px; opacity: .74; mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 85%, transparent 100%); background-size: cover; background-position: center 9%; }\n  .leadCard { position: absolute; left: 50%; bottom: 28px; width: min(390px, calc(100% - 20px)); max-width: none; transform: translateX(-50%); padding-top: 105px; }\n  .leadCard:hover { transform: translateX(-50%); }\n  .trustInner { grid-template-columns: 1fr 1fr; }\n  .trustItem { justify-content: flex-start; padding: 10px; }\n  .trustItem:last-child { grid-column: 1 / -1; justify-content: center; }\n  .trustItem span { font-size: 10px; }\n  .contentSection { padding-block: 44px; }\n  .sectionTitle { font-size: 28px; margin-bottom: 28px; }\n  .pillarGrid { grid-template-columns: 1fr; gap: 14px; }\n  .pillarGrid article { min-height: 170px; }\n  .resultGrid { grid-template-columns: 1.35fr .85fr; gap: 12px; }\n  .resultGrid > img { border-radius: 10px; }\n  .resultCopy h3 { font-size: 19px; }\n  .resultCopy p { font-size: 10px; }\n  .resultCopy li { font-size: 9px; line-height: 1.8; }\n  .guideOffer { width: calc(100% - 28px); grid-template-columns: 1fr; gap: 18px; padding: 24px; text-align: center; }\n  .offerImage img { max-height: 210px; }\n  .offerBenefits { grid-column: auto; display: block; padding-top: 15px; border-top: 1px solid rgba(224, 182, 176, .6); text-align: left; }\n  .faqGrid { grid-template-columns: 1fr; }\n  .faqSection { background-image: linear-gradient(90deg, rgba(255,247,245,.98), rgba(255,247,245,.88)), url('/assets/home-faq-decor.webp'); background-size: cover, auto 48%; background-position: center, right bottom; }\n  .footerGrid { gap: 28px 20px; }\n  .footerBottom { display: grid; gap: 9px; text-align: center; }\n  .footerBottom span:last-child { justify-content: center; }\n  .quizHeader { height: 74px; }\n  .quizHeader p { display: none; }\n  .quizHero { display: block; }\n  .quizPortrait { height: 350px; background-position: center 18%; }\n  .quizIntro { padding: 30px 20px 72px; text-align: center; }\n  .quizIntro h1 { font-size: 55px; }\n  .quizIntro h2 { font-size: 10px; }\n  .quizIntro > p { margin-inline: auto; font-size: 14px; }\n  .questionCard { width: calc(100% - 24px); margin-top: -42px; padding: 25px 14px; }\n  .quizProgress { width: 78%; }\n  .questionSwap h2 { font-size: 23px; }\n  .answerGrid { grid-template-columns: 1fr 1fr; gap: 10px; }\n  .answerGrid button { min-height: 175px; padding-inline: 10px; }\n  .answerGrid button:last-child { grid-column: 1 / -1; }\n  .answerIcon { width: 56px; height: 56px; }\n  .answerIcon svg { width: 29px; height: 29px; }\n  .quizControls { gap: 10px; }\n  .quizControls > button { font-size: 11px; }\n  .resultsCapture { display: block; margin-bottom: 28px; }\n  .resultsCapture > img { max-height: 245px; margin-bottom: 15px; }\n  .planProof { grid-template-columns: 1fr; gap: 14px; }\n  .planProof article { min-height: 0; padding: 23px; }\n  .quizTrust > div { grid-template-columns: 1fr 1fr; gap: 16px 0; }\n  .quizTrust span { border-right: 0; }\n  .quizTrust span:last-child { grid-column: 1 / -1; }\n  .quizPage { background-size: auto 390px, auto 390px, cover; }\n  .bookingHero { display: block; padding: 0 14px 22px; }\n  .callPortrait { height: 370px; margin-inline: -14px; mask-image: linear-gradient(to bottom, #000 82%, transparent); background-position: center 8%; }\n  .callWelcome { padding: 18px 5px 24px; }\n  .callWelcome h1 { font-size: 57px; }\n  .callWelcome h2 { font-size: 34px; margin-bottom: 24px; }\n  .calendarCard { min-height: 0; padding: 20px 16px; margin: 0 auto; }\n  .calendarGrid button { width: 29px; height: 29px; }\n  .nextSteps { padding-inline: 12px; }\n  .nextSteps > div { grid-template-columns: 1fr 1fr; }\n  .nextSteps article:not(:last-child)::after { display: none; }\n  .nextSteps article { padding-block: 14px; }\n  .bookingGuideInner { grid-template-columns: 1fr; gap: 20px; padding-block: 26px; }\n  .bookingGuideInner > img { max-height: 240px; }\n  .bookingReviewGrid { grid-template-columns: 1fr; }\n  .bookingReviewGrid article > p { min-height: 0; }\n  .bookingCta { width: calc(100% - 28px); grid-template-columns: 1fr; }\n  .bookingCta > img { min-height: 115px; max-height: 150px; }\n  .bookingCta h2 { font-size: 22px; }\n  .bookingFaq > div { grid-template-columns: 1fr; }\n}\n\n@media (max-width: 390px) {\n  .brand { font-size: 17px; letter-spacing: 4px; }\n  .brand span { font-size: 6px; }\n  .headerCta { padding-inline: 10px; }\n  .heroCopy h1 { font-size: 54px; }\n  .calendarGrid button { width: 26px; height: 26px; }\n  .calendarFacts span { padding-inline: 2px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }\n}\n"},{"file":"app/layout.tsx","data":"﻿import type { Metadata } from \"next\";\nimport \"./globals.css\";\n\nexport const metadata: Metadata = {\n  title: \"Lumiere Beauty & Wellness\",\n  description: \"Discover your glow with personalized beauty and wellness rituals.\",\n};\n\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n  return (\n    <html lang=\"en\">\n      <body>{children}</body>\n    </html>\n  );\n}\r\n"},{"file":"app/page.tsx","data":"\"use client\";\n\nimport { useState } from \"react\";\nimport {\n  ArrowRight,\n  Check,\n  ChevronDown,\n  Heart,\n  LockKeyhole,\n  Mail,\n  Sparkles,\n  WandSparkles,\n  Zap,\n} from \"lucide-react\";\nimport { Footer, Header, TrustBar } from \"./components\";\n\nconst pillars = [\n  [\"/assets/pillar-nourish.png\", \"Nourish Your Body\", \"Simple, feel-good nutrition that fuels your glow.\"],\n  [\"/assets/pillar-radiant.png\", \"Radiant Skin\", \"Proven skincare rituals for a natural, healthy glow.\"],\n  [\"/assets/pillar-calm.png\", \"Calm Your Mind\", \"Reduce stress and build habits that last.\"],\n  [\"/assets/pillar-confident.png\", \"Confident You\", \"Elevate your mindset and become your best self.\"],\n] as const;\n\nconst testimonials = [\n  [\"This guide changed my mornings, my skin, and my entire mindset. I finally feel like me again!\", \"Sarah J.\", \"New York, NY\", \"/assets/results-skin.webp\"],\n  [\"I love how simple and realistic everything is. I’ve never been more consistent or confident.\", \"Emily R.\", \"Austin, TX\", \"/assets/call-woman.webp\"],\n  [\"The quiz was so fun and the guide is full of easy tips that actually work. My glow is unreal!\", \"Megan L.\", \"Los Angeles, CA\", \"/assets/quiz-woman.webp\"],\n];\n\nconst faqs = [\n  [\"Is the guide really free?\", \"Yes—completely free. No credit card is needed, and you can start your personalized Glow Quiz immediately.\"],\n  [\"Is this for all ages and skin types?\", \"Yes. Your guide is personalized around your goals, current routine, lifestyle, and comfort level.\"],\n  [\"How long does it take to see results?\", \"Many women notice small shifts in consistency, energy, and confidence within the first few weeks of following their rituals.\"],\n  [\"How will I receive my guide?\", \"Complete the Glow Quiz and enter your email. Your personalized results and free guide will be ready right away.\"],\n];\n\nexport default function Home() {\n  const [email, setEmail] = useState(\"\");\n  const [openFaq, setOpenFaq] = useState<number | null>(null);\n\n  const startQuiz = (event: React.FormEvent) => {\n    event.preventDefault();\n    if (email) window.location.href = `/quiz?email=${encodeURIComponent(email)}`;\n  };\n\n  return (\n    <main>\n      <Header />\n\n      <section className=\"homeHero\" id=\"top\">\n        <div className=\"homeHeroInner shell\">\n          <div className=\"heroCopy\">\n            <p className=\"eyebrow\">SELF-CARE. CONFIDENCE. RADIANCE. <Sparkles /></p>\n            <h1>Glow From <em>Within</em></h1>\n            <p className=\"heroLead\">Transform your beauty, your habits, and your life<br />with simple rituals that create lasting results.</p>\n            <div className=\"heroBenefits\">\n              <span><Zap /> More Energy</span>\n              <span><Sparkles /> Clearer Skin</span>\n              <span><Heart /> Unshakable Confidence</span>\n            </div>\n          </div>\n\n          <div className=\"heroWoman\" role=\"img\" aria-label=\"Woman enjoying a calm beauty and wellness ritual\" />\n\n          <form className=\"leadCard\" onSubmit={startQuiz}>\n            <img src=\"/assets/guide.webp\" alt=\"Glow From Within beauty and wellness guide mockup\" />\n            <small>FREE GUIDE + QUIZ</small>\n            <h2>Discover Your Glow<br /><em>in 60 Seconds</em></h2>\n            <p>Take the quiz and get our Free Beauty &amp; Wellness Guide tailored to you.</p>\n            <label>\n              <Mail aria-hidden=\"true\" />\n              <span className=\"srOnly\">Email address</span>\n              <input type=\"email\" required value={email} onChange={(event) => setEmail(event.target.value)} placeholder=\"Enter your email address\" />\n            </label>\n            <button className=\"button\" type=\"submit\">TAKE THE QUIZ <ArrowRight /></button>\n            <div className=\"secure\"><LockKeyhole /> 100% FREE. No spam, ever.</div>\n          </form>\n        </div>\n      </section>\n\n      <TrustBar />\n\n      <section className=\"contentSection shell\" id=\"programs\">\n        <h2 className=\"sectionTitle\">Feel Beautiful. Inside &amp; Out.</h2>\n        <div className=\"pillarGrid\">\n          {pillars.map(([icon, title, description]) => (\n            <article key={title}>\n              <img className=\"pillarIcon\" src={icon} alt=\"\" />\n              <h3>{title}</h3>\n              <p>{description}</p>\n            </article>\n          ))}\n        </div>\n      </section>\n\n      <section className=\"contentSection testimonialSection\" id=\"about\">\n        <div className=\"shell\">\n          <h2 className=\"sectionTitle\">Real Women. Real Results. <Sparkles /></h2>\n          <div className=\"testimonialGrid\">\n            {testimonials.map(([quote, name, place, avatar]) => (\n              <article key={name}>\n                <div className=\"quoteMark\">“</div>\n                <p>{quote}</p>\n                <div className=\"stars\" aria-label=\"Five star review\">★★★★★</div>\n                <div className=\"reviewer\">\n                  <img src={avatar} alt=\"\" />\n                  <span><strong>{name}</strong><small>{place}</small></span>\n                </div>\n              </article>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      <section className=\"contentSection resultsSection shell\" id=\"results\">\n        <h2 className=\"sectionTitle\">Real Results. Real Transformations.</h2>\n        <div className=\"resultGrid\">\n          <img src=\"/assets/results-skin.webp\" alt=\"Before and after skin transformation\" />\n          <div className=\"resultCopy\">\n            <h3>Clearer Skin<br />Brighter You</h3>\n            <p>Visible results in just<br />4 weeks.</p>\n            <ul><li>Fewer breakouts</li><li>More even tone</li><li>Natural glow</li></ul>\n          </div>\n          <img src=\"/assets/results-body.webp\" alt=\"Before and after wellness transformation\" />\n          <div className=\"resultCopy\">\n            <h3>More Energy<br />Stronger You</h3>\n            <p>Feel lighter, stronger<br />and unstoppable.</p>\n            <ul><li>Boosted energy</li><li>Better digestion</li><li>Healthy habits</li></ul>\n          </div>\n        </div>\n      </section>\n\n      <section className=\"guideOffer shell\" id=\"guide\">\n        <div className=\"offerImage\"><img src=\"/assets/guide.webp\" alt=\"Free Glow From Within guide and mobile preview\" /></div>\n        <div className=\"offerHeadline\">\n          <small>LIMITED TIME OFFER</small>\n          <h2>Your Free Beauty &amp;<br />Wellness Guide Awaits</h2>\n          <p>Join thousands of women transforming their lives<br />with simple daily rituals.</p>\n        </div>\n        <div className=\"offerBenefits\">\n          <ul>\n            <li><Check /> Personalized tips just for you</li>\n            <li><Check /> Easy-to-follow beauty &amp; wellness routines</li>\n            <li><Check /> Science-backed &amp; expert-approved</li>\n            <li><Check /> Instant access to your free guide</li>\n          </ul>\n          <a className=\"button\" href=\"/quiz\">GET MY FREE GUIDE <ArrowRight /></a>\n          <small><LockKeyhole /> No credit card required. 100% free.</small>\n        </div>\n      </section>\n\n      <section className=\"faqSection shell\" id=\"faq\">\n        <h2>Frequently Asked Questions <WandSparkles /></h2>\n        <div className=\"faqGrid\">\n          {faqs.map(([question, answer], index) => (\n            <article className={openFaq === index ? \"open\" : \"\"} key={question}>\n              <button onClick={() => setOpenFaq(openFaq === index ? null : index)} aria-expanded={openFaq === index}>\n                {question}<ChevronDown />\n              </button>\n              <p>{answer}</p>\n            </article>\n          ))}\n        </div>\n      </section>\n\n      <Footer />\n    </main>\n  );\n}\n"},{"file":"app/quiz/page.tsx","data":"\"use client\";\n\nimport { useState } from \"react\";\nimport {\n  ArrowLeft,\n  ArrowRight,\n  Check,\n  Clock3,\n  Droplets,\n  Gift,\n  Heart,\n  Leaf,\n  LockKeyhole,\n  Mail,\n  ShieldCheck,\n  Smile,\n  Sparkles,\n  Star,\n  SunMedium,\n  UserRound,\n  Users,\n  WandSparkles,\n} from \"lucide-react\";\nimport { Brand } from \"../components\";\n\nconst questions = [\n  {\n    title: \"How would you describe your skin right now?\",\n    options: [\n      [\"Clear & Balanced\", \"Pretty happy overall, just want to maintain my glow.\"],\n      [\"Oily / Acne-Prone\", \"I struggle with breakouts, oiliness, or clogged pores.\"],\n      [\"Dry / Dull\", \"My skin feels dry, tight, or lacks radiance.\"],\n      [\"Sensitive / Reactive\", \"My skin gets red, irritated, or reacts easily.\"],\n      [\"Mature / Aging\", \"I’m noticing fine lines, loss of firmness, or dullness.\"],\n    ],\n  },\n  {\n    title: \"What would you most love to improve?\",\n    options: [\n      [\"Clearer Skin\", \"A calm, smooth, more even-looking complexion.\"],\n      [\"More Energy\", \"Steadier energy that carries me through the day.\"],\n      [\"Better Digestion\", \"A lighter, more comfortable daily rhythm.\"],\n      [\"Less Stress\", \"More calm, clarity, and room to breathe.\"],\n      [\"More Confidence\", \"To feel radiant and at home in my body.\"],\n    ],\n  },\n  {\n    title: \"How much time can you give yourself daily?\",\n    options: [\n      [\"5 Minutes\", \"A quick ritual I can do even on busy days.\"],\n      [\"10 Minutes\", \"A simple morning or evening reset.\"],\n      [\"15 Minutes\", \"Enough time for a complete daily routine.\"],\n      [\"20 Minutes\", \"I’m ready to protect this time for myself.\"],\n      [\"Whatever It Takes\", \"I’m committed to building lasting habits.\"],\n    ],\n  },\n  {\n    title: \"What best describes your current routine?\",\n    options: [\n      [\"Just Starting\", \"I’m ready for clear, beginner-friendly steps.\"],\n      [\"Simple Basics\", \"I have a few rituals that already work for me.\"],\n      [\"On And Off\", \"I need a routine that is easier to stay with.\"],\n      [\"Very Consistent\", \"I want to refine and personalize what I do.\"],\n      [\"Ready For A Reset\", \"I’m open to a fresh start that feels good.\"],\n    ],\n  },\n  {\n    title: \"What does your ideal glow feel like?\",\n    options: [\n      [\"Calm\", \"Grounded, rested, and at ease.\"],\n      [\"Radiant\", \"Fresh, bright, and naturally luminous.\"],\n      [\"Energized\", \"Strong, focused, and ready for my day.\"],\n      [\"Balanced\", \"Supported from the inside out.\"],\n      [\"Confident\", \"Comfortable, capable, and fully myself.\"],\n    ],\n  },\n] as const;\n\nconst optionIcons = [Smile, Droplets, SunMedium, ShieldCheck, Heart] as const;\nconst skinIcons = [\n  \"/assets/skin-clear.png\",\n  \"/assets/skin-oily.png\",\n  \"/assets/skin-dry.png\",\n  \"/assets/skin-sensitive.png\",\n  \"/assets/skin-mature.png\",\n] as const;\nconst trustItems = [\n  [Users, \"10,000+\", \"Happy Women\"],\n  [Star, \"4.9/5\", \"Average Rating\"],\n  [ShieldCheck, \"Expert-Backed\", \"Wellness\"],\n  [Heart, \"Female Founded\", \"& Led\"],\n  [Leaf, \"Science + Nature\", \"Combined\"],\n] as const;\n\nexport default function Quiz() {\n  const [step, setStep] = useState(0);\n  const [answers, setAnswers] = useState<string[]>([]);\n  const [name, setName] = useState(\"\");\n  const [email, setEmail] = useState(() => typeof window === \"undefined\" ? \"\" : new URLSearchParams(window.location.search).get(\"email\") || \"\");\n  const [quizComplete, setQuizComplete] = useState(false);\n  const [resultsReady, setResultsReady] = useState(false);\n  const selected = answers[step];\n\n  const choose = (value: string) => {\n    const nextAnswers = [...answers];\n    nextAnswers[step] = value;\n    setAnswers(nextAnswers);\n  };\n\n  const next = () => {\n    if (!selected) return;\n    if (step < questions.length - 1) {\n      setStep((value) => value + 1);\n      return;\n    }\n    setQuizComplete(true);\n    window.setTimeout(() => document.querySelector(\"#personalize\")?.scrollIntoView({ behavior: \"smooth\", block: \"center\" }), 180);\n  };\n\n  const back = () => {\n    if (step > 0) {\n      setStep((value) => value - 1);\n      setQuizComplete(false);\n    } else {\n      window.location.href = \"/\";\n    }\n  };\n\n  return (\n    <main className=\"quizPage\">\n      <header className=\"quizHeader shell\">\n        <Brand />\n        <p>JOIN 10,000+ WOMEN GLOWING FROM WITHIN <Sparkles /></p>\n      </header>\n\n      <section className=\"quizHero\">\n        <div className=\"quizPortrait\" role=\"img\" aria-label=\"Woman beginning her personalized Glow Quiz\" />\n        <div className=\"quizIntro\">\n          <h1>Take the<br /><em>Glow</em> Quiz <Sparkles /></h1>\n          <h2>FIND YOUR PERSONALIZED WELLNESS PLAN</h2>\n          <p>Discover what your body truly needs to glow from within — and get a custom plan tailored just for you.</p>\n          <div className=\"quizPerks\">\n            <span><Clock3 /><small>2-Minute Quiz</small></span>\n            <span><WandSparkles /><small>Personalized<br />Results</small></span>\n            <span><Gift /><small>Free Guide<br />Included</small></span>\n            <span><ShieldCheck /><small>100% Private<br />No Spam</small></span>\n          </div>\n        </div>\n      </section>\n\n      <section className={`questionCard${quizComplete ? \" complete\" : \"\"}`}>\n        <div className=\"stepLabel\">STEP {step + 1} OF {questions.length}</div>\n        <div className=\"quizProgress\" aria-label={`Quiz progress: step ${step + 1} of ${questions.length}`}>\n          <div className=\"progressLine\"><i style={{ width: `${(step / (questions.length - 1)) * 100}%` }} /></div>\n          {questions.map((_, index) => <span key={index} className={index <= step ? \"active\" : \"\"} />)}\n        </div>\n\n        <div className=\"questionSwap\" key={step}>\n          <h2>{questions[step].title}</h2>\n          <p>Choose the option that feels most like you.</p>\n          <div className=\"answerGrid\">\n            {questions[step].options.map(([label, description], index) => {\n              const Icon = optionIcons[index];\n              const isSelected = selected === label;\n              return (\n                <button key={label} className={isSelected ? \"selected\" : \"\"} onClick={() => choose(label)} aria-pressed={isSelected}>\n                  {isSelected && <b className=\"selectedCheck\"><Check /></b>}\n                  <span className={`answerIcon${step === 0 ? \" illustrated\" : \"\"}`}>\n                    {step === 0 ? <img src={skinIcons[index]} alt=\"\" /> : <Icon />}\n                  </span>\n                  <strong>{label}</strong>\n                  <small>{description}</small>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        <div className=\"quizControls\">\n          <button onClick={back}><ArrowLeft /> Back</button>\n          <button className=\"button\" disabled={!selected} onClick={next}>\n            {step === questions.length - 1 ? \"COMPLETE QUIZ\" : \"NEXT\"} <ArrowRight />\n          </button>\n        </div>\n        {quizComplete && <div className=\"quizDone\"><Sparkles /> Quiz complete—your personalized plan is ready below.</div>}\n      </section>\n\n      <section className=\"resultsCapture shell\" id=\"personalize\">\n        <img src=\"/assets/personal-plan.webp\" alt=\"Your Personal Glow Plan guide and mobile preview\" />\n        <form onSubmit={(event) => { event.preventDefault(); if (name && email) setResultsReady(true); }}>\n          <h2>Almost there! Let’s personalize your results.</h2>\n          <p>Enter your details to receive your custom glow plan and exclusive wellness guide.</p>\n          {resultsReady ? (\n            <div className=\"resultSuccess\">\n              <b><Sparkles /> Your glow plan is ready!</b>\n              <span>We’ve personalized your first steps. Book your complimentary call to continue your glow journey.</span>\n              <a className=\"button\" href=\"/booking\">BOOK MY FREE CALL <ArrowRight /></a>\n            </div>\n          ) : (\n            <>\n              <label><UserRound /><span className=\"srOnly\">First name</span><input required value={name} onChange={(event) => setName(event.target.value)} placeholder=\"First Name\" /></label>\n              <label><Mail /><span className=\"srOnly\">Email address</span><input required type=\"email\" value={email} onChange={(event) => setEmail(event.target.value)} placeholder=\"Email Address\" /></label>\n              <button className=\"button\">GET MY RESULTS <ArrowRight /></button>\n              <small><LockKeyhole /> We respect your privacy. No spam, ever.</small>\n            </>\n          )}\n        </form>\n      </section>\n\n      <section className=\"planProof shell\">\n        <article>\n          <h2>Your Personalized Plan Will Help You:</h2>\n          <ul>\n            <li><Check /> Reveal clearer, brighter, more radiant skin</li>\n            <li><Check /> Balance your routine &amp; boost your natural energy</li>\n            <li><Check /> Improve gut health &amp; digestion</li>\n            <li><Check /> Reduce stress, bloating &amp; inflammation</li>\n            <li><Check /> Build healthy habits that actually last</li>\n          </ul>\n        </article>\n        <article className=\"quizReview\">\n          <div className=\"quoteMark\">“</div>\n          <p>“This quiz was a total game-changer! I finally understand what my body needs and my skin has never looked better.”</p>\n          <div className=\"stars\">★★★★★</div>\n          <div className=\"reviewer\"><img src=\"/assets/results-skin.webp\" alt=\"\" /><span><strong>Sarah J.</strong><small>Austin, TX</small></span></div>\n        </article>\n      </section>\n\n      <section className=\"quizTrust\">\n        <h2>Trusted by Thousands of Women</h2>\n        <div className=\"shell\">\n          {trustItems.map(([Icon, title, subtitle]) => (\n            <span key={title}><Icon /><b>{title}</b><small>{subtitle}</small></span>\n          ))}\n        </div>\n      </section>\n    </main>\n  );\n}\n"},{"file":"eslint.config.mjs","data":"import { defineConfig, globalIgnores } from \"eslint/config\";\nimport nextVitals from \"eslint-config-next/core-web-vitals\";\nimport nextTs from \"eslint-config-next/typescript\";\n\nconst eslintConfig = defineConfig([\n  ...nextVitals,\n  ...nextTs,\n  // Override default ignores of eslint-config-next.\n  globalIgnores([\n    // Default ignores of eslint-config-next:\n    \".next/**\",\n    \"out/**\",\n    \"build/**\",\n    \"next-env.d.ts\",\n  ]),\n]);\n\nexport default eslintConfig;\n"},{"file":"next-env.d.ts","data":"/// <reference types=\"next\" />\r\n/// <reference types=\"next/image-types/global\" />\r\nimport \"./.next/types/routes.d.ts\";\r\n\r\n// NOTE: This file should not be edited\r\n// see https://nextjs.org/docs/app/api-reference/config/typescript for more information.\r\n"},{"file":"next.config.ts","data":"import type { NextConfig } from \"next\";\n\nconst nextConfig: NextConfig = {\n  /* config options here */\n};\n\nexport default nextConfig;\n"},{"file":"package-lock.json","data":"{\n  \"name\": \"lumiere-beauty-wellness\",\n  \"version\": \"0.1.0\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {\n    \"\": {\n      \"name\": \"lumiere-beauty-wellness\",\n      \"version\": \"0.1.0\",\n      \"dependencies\": {\n        \"lucide-react\": \"^0.468.0\",\n        \"next\": \"16.2.6\",\n        \"react\": \"19.2.6\",\n        \"react-dom\": \"19.2.6\"\n      },\n      \"devDependencies\": {\n        \"@tailwindcss/postcss\": \"4.2.1\",\n        \"@types/node\": \"22.19.19\",\n        \"@types/react\": \"19.2.14\",\n        \"@types/react-dom\": \"19.2.3\",\n        \"tai